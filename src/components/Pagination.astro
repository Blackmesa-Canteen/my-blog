---
interface Props {
  currentPage: number;
  totalPages: number;
}
const { currentPage, totalPages } = Astro.props;

const pageHref = (page: number) => (page === 1 ? '/' : `/page/${page}/`);
---
{totalPages > 1 && (
  <nav class="pagination" aria-label="Pagination">
    {currentPage > 1 ? (
      <a href={pageHref(currentPage - 1)} rel="prev">&larr; Newer</a>
    ) : <span />}
    <span class="pagination-status">Page {currentPage} of {totalPages}</span>
    {currentPage < totalPages ? (
      <a href={pageHref(currentPage + 1)} rel="next">Older &rarr;</a>
    ) : <span />}
  </nav>
)}

<style>
  .pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .pagination-status {
    color: var(--muted);
    font-size: 0.9em;
  }
</style>
