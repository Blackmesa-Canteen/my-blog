---
interface Props {
  currentPage: number;
  totalPages: number;
}
import Bi from './Bi.astro';

const { currentPage, totalPages } = Astro.props;

const pageHref = (page: number) => (page === 1 ? '/' : `/page/${page}/`);

// First, last, and two either side of the current page; gaps become "…".
const shown = [...new Set([1, currentPage - 2, currentPage - 1, currentPage, currentPage + 1, currentPage + 2, totalPages])]
  .filter((page) => page >= 1 && page <= totalPages)
  .sort((a, b) => a - b);
const items: (number | 'gap')[] = [];
for (const page of shown) {
  const prev = items[items.length - 1];
  if (typeof prev === 'number' && page - prev > 1) items.push(page - prev === 2 ? prev + 1 : 'gap');
  items.push(page);
}
---
{totalPages > 1 && (
  <nav class="pagination" aria-label="Pagination">
    {currentPage > 1 ? (
      <a class="pagination-step" href={pageHref(currentPage - 1)} rel="prev">&larr; <Bi zh="较新" en="Newer" /></a>
    ) : <span class="pagination-step" aria-hidden="true" />}
    <ol class="pagination-pages">
      {items.map((item) => item === 'gap' ? (
        <li class="pagination-gap" aria-hidden="true">…</li>
      ) : (
        <li>
          {item === currentPage ? (
            <span class="pagination-page current" aria-current="page" data-total={totalPages}>{item}</span>
          ) : (
            <a class="pagination-page" href={pageHref(item)} aria-label={`Page ${item}`}>{item}</a>
          )}
        </li>
      ))}
    </ol>
    {currentPage < totalPages ? (
      <a class="pagination-step" href={pageHref(currentPage + 1)} rel="next"><Bi zh="较旧" en="Older" /> &rarr;</a>
    ) : <span class="pagination-step" aria-hidden="true" />}
  </nav>
)}

<style>
  /* Three columns so the page numbers sit in the true centre whether or not
     there is a "newer" link on the left. */
  .pagination {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .pagination-step, .pagination-page {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    height: 2.75rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    white-space: nowrap;
  }
  .pagination-step { justify-self: start; padding: 0 1.1rem; }
  .pagination-step:last-child { justify-self: end; }
  span.pagination-step { visibility: hidden; }
  .pagination-pages { display: flex; gap: 0.4rem; list-style: none; margin: 0; padding: 0; }
  .pagination-page { min-width: 2.75rem; padding: 0 0.5rem; font-variant-numeric: tabular-nums; }
  a.pagination-step:hover, a.pagination-page:hover { border-color: var(--accent-strong); text-decoration: none; }
  .pagination-page.current { background: var(--accent); border-color: var(--accent); color: var(--bg); font-weight: 600; }
  .pagination-gap { display: grid; place-items: center; min-width: 1.5rem; color: var(--muted); }
  @media (max-width: 560px) {
    /* On phones keep the two steps and a compact "n / total" in between. */
    .pagination { gap: 0.5rem; }
    .pagination-step { padding: 0 0.75rem; }
    .pagination-pages li:not(:has(.current)) { display: none; }
    .pagination-page.current { background: none; border: none; color: var(--muted); font-weight: 500; }
    .pagination-page.current::after { content: ' / ' attr(data-total); }
  }
</style>
