---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Toc from '../../components/Toc.astro';
import { detectLang } from '../../lib/lang';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const lang = detectLang(`${post.data.title}\n${post.body ?? ''}`);

// h2/h3 only; a TOC for one or two headings is just clutter.
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const showToc = tocHeadings.length >= 3;
const tocLabel = lang === 'zh' ? '目录' : 'Contents';
---
<BaseLayout title={`${post.data.title} · 996工人之家`} lang={lang} wide>
  <div class:list={['post-layout', { 'has-toc': showToc }]}>
    {showToc && (
      <aside class="toc-sidebar">
        <p class="toc-title">{tocLabel}</p>
        <Toc headings={tocHeadings} lang={lang} />
      </aside>
    )}
    <article>
      <h1>{post.data.title}</h1>
      <p class="post-meta">
        {post.data.date.toISOString().slice(0, 10)}
        {post.data.categories.length > 0 && ` · ${post.data.categories.join(', ')}`}
      </p>
      {showToc && (
        <details class="toc-inline">
          <summary>{tocLabel}</summary>
          <Toc headings={tocHeadings} lang={lang} topLevelOnly={tocHeadings.length > 30} />
        </details>
      )}
      {post.data.cover && (
        <Image src={post.data.cover} alt={post.data.title} width={800} />
      )}
      <Content />
      {post.data.tags.length > 0 && (
        <p class="tag-list">
          {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
        </p>
      )}
    </article>
  </div>
  <a href="#top" class="back-to-top" aria-label={lang === 'zh' ? '回到顶部' : 'Back to top'} data-pagefind-ignore>↑</a>
</BaseLayout>

<script>
  // Scroll-spy for the sidebar TOC: highlight the heading the reader is in,
  // expand only that section's sub-headings, and keep the active entry
  // visible inside the (independently scrolling) sidebar.
  const sidebar = document.querySelector<HTMLElement>('.toc-sidebar');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc-sidebar [data-toc-link]')];
  const targets = links
    .map((link) => document.getElementById(link.dataset.tocLink!))
    .filter((el): el is HTMLElement => el !== null);

  let current: string | null = null;
  function update() {
    const offset = window.innerHeight * 0.25;
    let active: HTMLElement | undefined;
    for (const el of targets) {
      if (el.getBoundingClientRect().top - offset <= 0) active = el;
      else break;
    }
    const id = active?.id ?? null;
    if (id === current) return;
    current = id;
    for (const link of links) link.classList.toggle('active', link.dataset.tocLink === id);
    const activeLink = links.find((link) => link.dataset.tocLink === id);
    const section = activeLink?.closest('[data-toc-section]');
    for (const li of document.querySelectorAll('.toc-sidebar [data-toc-section]')) {
      li.classList.toggle('open', li === section);
    }
    if (sidebar && activeLink) {
      const box = sidebar.getBoundingClientRect();
      const item = activeLink.getBoundingClientRect();
      if (item.top < box.top || item.bottom > box.bottom) {
        sidebar.scrollTop += item.top - box.top - box.height / 3;
      }
    }
  }

  const backToTop = document.querySelector<HTMLElement>('.back-to-top');
  let queued = false;
  function onScroll() {
    if (queued) return;
    queued = true;
    requestAnimationFrame(() => {
      queued = false;
      if (targets.length > 0) update();
      backToTop?.classList.toggle('visible', window.scrollY > window.innerHeight);
    });
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Close the inline (mobile) TOC once the reader picks a section.
  for (const link of document.querySelectorAll('.toc-inline a')) {
    link.addEventListener('click', () => link.closest('details')?.removeAttribute('open'));
  }
</script>
