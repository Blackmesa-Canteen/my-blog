---
import TermPage from '../../components/TermPage.astro';
import { getSortedPosts, getTerms, type Term } from '../../lib/posts';

export async function getStaticPaths() {
  const terms = getTerms(await getSortedPosts(), 'categories');
  return terms.map((term) => ({ params: { category: term.slug }, props: { term } }));
}

const { term } = Astro.props as { term: Term };
---
<TermPage kind="categories" term={term} />
