---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostIndex from '../components/PostIndex.astro';
import { getSortedPosts, POSTS_PER_PAGE } from '../lib/posts';
import { SITE } from '../lib/site';

const posts = await getSortedPosts();
const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  description: SITE.description,
  url: new URL('/', Astro.site).href,
};
---
<BaseLayout title={SITE.name} wide searchable={false} jsonLd={jsonLd}>
  <PostIndex allPosts={posts} pagePosts={posts.slice(0, POSTS_PER_PAGE)} currentPage={1} totalPages={totalPages} />
</BaseLayout>
