---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSortedPosts, getTerms, termHref } from '../../lib/posts';

const posts = await getSortedPosts();
const categories = getTerms(posts, 'categories');
const tags = getTerms(posts, 'tags');
const byName = [...tags].sort((a, b) => a.name.localeCompare(b.name, 'en', { sensitivity: 'base' }));
---
<BaseLayout
  title="Categories & Tags · 996工人之家"
  description={`Browse 996工人之家 by ${categories.length} categories and ${tags.length} tags.`}
  searchable={false}
>
  <h1>Categories &amp; Tags</h1>
  <h2>Categories</h2>
  <ul class="count-list count-grid">
    {categories.map((term) => (
      <li><a href={termHref('categories', term.name)}>{term.name}</a><span class="count">{term.count}</span></li>
    ))}
  </ul>
  <h2>Tags <span class="heading-count">{tags.length}</span></h2>
  <ul class="count-list count-grid">
    {byName.map((term) => (
      <li><a href={termHref('tags', term.name)}>#{term.name}</a><span class="count">{term.count}</span></li>
    ))}
  </ul>
</BaseLayout>
