---
interface Props {
  title: string;
  description?: string;
  lang?: 'en' | 'zh';
}
const { title, description = '996工人之家', lang = 'en' } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <nav>
        <a class="brand" href="/">996工人之家</a>
        <a href="/">Posts</a>
        <a href="/about">About</a>
        <a href="/tea-house">Tea House</a>
        <a href="/search">Search</a>
      </nav>
    </header>
    <main data-pagefind-body>
      <slot />
    </main>
    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} 996工人之家</p>
    </footer>
  </body>
</html>

<style is:global>
  /*
   * Palette borrowed from the 996-workers-org homepage (SaddleBrown /
   * Peru / Gold on a beige ground) -- identity only, not the full retro
   * kitsch: body copy stays a clean sans-serif for readability, the
   * warm palette carries the brand into headings, links, and accents.
   */
  :root {
    color-scheme: light dark;
    --max-width: 720px;
    --fg: #2b2116;
    --bg: #fefbf3;
    --muted: #8a7256;
    --accent: #8b4513;
    --accent-strong: #cd853f;
    --highlight: #ffd700;
    --border: #e6d9c0;
    --surface: #faf6e9;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --fg: #f1e6d2;
      --bg: #1c150d;
      --muted: #b39d7a;
      --accent: #e3a458;
      --accent-strong: #f0c674;
      --highlight: #f0c674;
      --border: #4a3a24;
      --surface: #241b10;
    }
  }
  * { box-sizing: border-box; }
  html, body { padding: 0; margin: 0; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', 'Noto Sans SC', sans-serif;
    color: var(--fg);
    background: var(--bg);
    line-height: 1.7;
  }
  a { color: var(--accent); text-decoration: none; }
  a:hover { color: var(--accent-strong); text-decoration: underline; }
  .site-header {
    background: var(--surface);
    border-bottom: 2px solid var(--highlight);
  }
  .site-header nav {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1rem;
    display: flex;
    gap: 1.25rem;
    align-items: center;
  }
  .site-header .brand {
    font-weight: 700;
    color: var(--accent);
    margin-right: auto;
  }
  main {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2rem 1rem;
    min-height: 60vh;
  }
  main h1, main h2, main h3 { color: var(--accent); }
  main h2 { padding-bottom: 0.3rem; border-bottom: 2px solid var(--highlight); }
  main img { max-width: 100%; height: auto; border-radius: 6px; }
  main pre { overflow-x: auto; padding: 1rem; border-radius: 6px; background: #1e1e1e; }
  main code { font-size: 0.9em; }
  main pre code { background: none; }
  .site-footer {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2rem 1rem;
    color: var(--muted);
    font-size: 0.9em;
    border-top: 1px solid var(--border);
  }
  .post-meta {
    color: var(--muted);
    font-size: 0.9em;
    margin-bottom: 1.5rem;
  }
  .post-list-item {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border);
  }
  .post-list-item h2 {
    margin: 0 0 0.25rem 0;
    padding-bottom: 0;
    border-bottom: none;
  }
  .tag-list { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.5rem; }
  .tag {
    font-size: 0.8em;
    color: var(--accent-strong);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.1rem 0.6rem;
  }

  /*
   * Shared styling for the hand-drawn inline SVG diagrams that replace
   * dead-image placeholders left over from the Halo migration. Diagrams
   * are plain inline <svg data-diagram> markup in post content; these
   * rules keep them on the site's theme (incl. dark mode) without every
   * diagram having to repeat fill/stroke colors.
   */
  svg[data-diagram] {
    display: block;
    width: 100%;
    height: auto;
    max-width: 640px;
    margin: 1.75rem auto;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', 'Noto Sans SC', sans-serif;
  }
  svg[data-diagram] .d-box {
    fill: var(--surface);
    stroke: var(--accent);
    stroke-width: 1.5;
  }
  svg[data-diagram] .d-box-muted {
    fill: var(--bg);
    stroke: var(--border);
    stroke-width: 1.5;
  }
  svg[data-diagram] .d-box-alt {
    fill: var(--bg);
    stroke: var(--muted);
    stroke-width: 1.5;
    stroke-dasharray: 4 3;
  }
  svg[data-diagram] .d-line {
    stroke: var(--fg);
    stroke-width: 1.5;
    fill: none;
  }
  svg[data-diagram] .d-line-muted {
    stroke: var(--muted);
    stroke-width: 1.25;
    fill: none;
  }
  svg[data-diagram] .d-line-accent {
    stroke: var(--accent-strong);
    stroke-width: 1.75;
    fill: none;
  }
  svg[data-diagram] .d-arrow {
    fill: var(--fg);
  }
  svg[data-diagram] .d-arrow-muted {
    fill: var(--muted);
  }
  svg[data-diagram] .d-arrow-accent {
    fill: var(--accent-strong);
  }
  svg[data-diagram] text {
    fill: var(--fg);
    font-size: 13px;
  }
  svg[data-diagram] .d-label {
    fill: var(--muted);
    font-size: 11px;
  }
  svg[data-diagram] .d-title {
    fill: var(--accent);
    font-weight: 600;
    font-size: 13px;
  }
  svg[data-diagram] .d-mono {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
</style>
