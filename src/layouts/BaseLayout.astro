---
import { SITE } from '../lib/site';
import Icon, { type IconName } from '../components/Icon.astro';
import Bi from '../components/Bi.astro';

interface Props {
  title: string;
  description?: string;
  lang?: 'en' | 'zh';
  /** Let the page lay out its own width (post pages, which add a TOC sidebar). */
  wide?: boolean;
  /** Include this page in the Pagefind search index. Off for listing pages, so results point at articles. */
  searchable?: boolean;
  /** Keep the page out of search engines (404, the empty search page). Also drops the canonical link. */
  noindex?: boolean;
  /** Absolute URL of the Open Graph / Twitter card image. */
  image?: string;
  /** Set on post pages: switches og:type to article and adds article metadata. */
  article?: { published: Date; tags: string[] };
  /** Schema.org JSON-LD object for this page. */
  jsonLd?: Record<string, unknown>;
}
const {
  title,
  description = SITE.description,
  lang = 'en',
  wide = false,
  searchable = true,
  noindex = false,
  image,
  article,
  jsonLd,
} = Astro.props;

// Every page is served from a directory index, so the slash form is the one true URL.
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site).href;

const navItems: { href: string; zh: string; en: string; icon: IconName; match: (path: string) => boolean }[] = [
  { href: '/', zh: '文章', en: 'Posts', icon: 'posts', match: (path: string) => path === '/' || path.startsWith('/page/') || path.startsWith('/posts/') },
  { href: '/archive/', zh: '归档', en: 'Archive', icon: 'archive', match: (path: string) => path.startsWith('/archive') },
  { href: '/tags/', zh: '标签', en: 'Tags', icon: 'tags', match: (path: string) => path.startsWith('/tags') || path.startsWith('/categories') },
  { href: '/about/', zh: '关于', en: 'About', icon: 'about', match: (path: string) => path.startsWith('/about') },
  { href: '/tea-house/', zh: '茶馆', en: 'Tea House', icon: 'teahouse', match: (path: string) => path.startsWith('/tea-house') },
  { href: '/search/', zh: '搜索', en: 'Search', icon: 'search', match: (path: string) => path.startsWith('/search') },
];
const path = Astro.url.pathname;

// 开往 (Travellings) webring: a random-member link that must be visible on first load.
const travellings = { href: 'https://www.travellings.cn/go.html', title: '开往-友链接力' };
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article?.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body id="top">
    <a class="skip-link" href="#content"><Bi zh="跳到正文" en="Skip to content" /></a>
    <header class="site-header">
      <nav aria-label="Site">
        <a class="brand" href="/">{SITE.name}</a>
        <div class="nav-links">
          {navItems.map((item) => (
            <a href={item.href} aria-current={item.match(path) ? 'page' : undefined}>
              <Icon name={item.icon} />
              <Bi zh={item.zh} en={item.en} stack />
            </a>
          ))}
        </div>
        <a class="travellings-link" href={travellings.href} target="_blank" rel="noopener" title={travellings.title}>
          <Icon name="train" />
          <Bi zh="开往" en="Travelling" stack />
        </a>
      </nav>
    </header>
    <main id="content" class:list={{ wide }} data-pagefind-body={searchable ? '' : undefined}>
      <slot />
    </main>
    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} {SITE.name} · <a href="/rss.xml">RSS</a></p>
      <a class="travellings-badge" href={travellings.href} target="_blank" rel="noopener" title={travellings.title}>
        <picture>
          <source srcset="/travellings/b.png" media="(prefers-color-scheme: dark)" />
          <img src="/travellings/w.png" alt={travellings.title} width="120" height="30" loading="lazy" />
        </picture>
      </a>
    </footer>
  </body>
</html>

<style is:global>
  /*
   * Palette borrowed from the 996-workers-org homepage (SaddleBrown /
   * Peru / Gold on a beige ground) -- identity only, not the full retro
   * kitsch: body copy stays a clean sans-serif for readability, the
   * warm palette carries the brand into headings, links, and accents.
   */
  :root {
    color-scheme: light dark;
    --max-width: 800px;
    --page-width: 1360px;
    --toc-width: 240px;
    --fg: #2b2116;
    --bg: #fefbf3;
    --muted: #7a6248;
    --accent: #8b4513;
    --accent-strong: #cd853f;
    --highlight: #ffd700;
    --border: #e6d9c0;
    --surface: #faf6e9;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --fg: #f1e6d2;
      --bg: #1c150d;
      --muted: #b39d7a;
      --accent: #e3a458;
      --accent-strong: #f0c674;
      --highlight: #f0c674;
      --border: #4a3a24;
      --surface: #241b10;
    }
  }
  * { box-sizing: border-box; }
  html, body { padding: 0; margin: 0; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', 'Noto Sans SC', sans-serif;
    color: var(--fg);
    background: var(--bg);
    line-height: 1.75;
  }
  main { font-size: 1.0625rem; }
  a { color: var(--accent); text-decoration: none; }
  a:hover { color: var(--accent-strong); text-decoration: underline; }
  .site-header {
    background: var(--surface);
    border-bottom: 2px solid var(--highlight);
  }
  .site-header nav {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 1rem;
    display: flex;
    gap: 1.25rem;
    align-items: center;
  }
  .site-header .brand {
    flex: none;
    font-weight: 700;
    color: var(--accent);
    margin-right: auto;
  }
  .site-header a:hover { text-decoration: none; }
  .nav-links { display: flex; gap: 0.25rem; min-width: 0; }
  .nav-links a, .travellings-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.65rem;
    border-radius: 6px;
    white-space: nowrap;
    color: var(--fg);
  }
  .nav-links .icon, .travellings-link .icon { flex: none; opacity: 0.75; }
  .nav-links a:hover, .travellings-link:hover { color: var(--accent); background: var(--bg); }
  .nav-links a[aria-current='page'] { color: var(--accent); background: var(--bg); box-shadow: inset 0 -2px 0 var(--highlight); }
  .nav-links a[aria-current='page'] .icon { opacity: 1; }
  /* Header labels: Chinese on top, English underneath. */
  .site-header .bi-zh { font-size: 0.95rem; font-weight: 500; }
  .site-header .bi-en { font-size: 0.7rem; letter-spacing: 0.02em; }
  .travellings-link { flex: none; margin-left: -1rem; }
  @media (max-width: 900px) {
    /* Brand and 开往 on the first row; the nav scrolls sideways on the second
       rather than wrapping into a third. */
    .site-header nav { flex-wrap: wrap; gap: 0.5rem; padding: 0.75rem 1rem 0.5rem; }
    .nav-links {
      order: 1;
      width: calc(100% + 2rem);
      margin: 0 -1rem;
      padding: 0 1rem 0.25rem;
      overflow-x: auto;
      scrollbar-width: none;
      mask-image: linear-gradient(to right, transparent, #000 1rem, #000 calc(100% - 1.5rem), transparent);
    }
    .nav-links::-webkit-scrollbar { display: none; }
    .nav-links a { padding: 0.35rem 0.55rem; }
    /* 开往 must be visible on first load, so on phones it stays on the
       brand row instead of scrolling off the end of the nav. */
    .travellings-link { margin-left: 0; }
  }
  /* Bilingual labels (see Bi.astro): English follows the Chinese, smaller and muted. */
  .bi { display: inline-flex; align-items: baseline; gap: 0.35em; }
  .bi-en { font-size: 0.72em; font-weight: 500; color: var(--muted); }
  .bi-stack { flex-direction: column; align-items: flex-start; gap: 0; line-height: 1.2; }
  a:hover .bi-en, [aria-current='page'] .bi-en { color: inherit; opacity: 0.8; }
  .skip-link .bi-en { color: inherit; }
  /* Small-caps section titles are already tiny; shrink the English less there (keeps it ≥ 11px). */
  .sidebar-section h2 .bi-en, .toc-title .bi-en { font-size: 0.9em; }
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -3rem;
    z-index: 10;
    padding: 0.5rem 1rem;
    background: var(--accent);
    color: var(--bg);
    border-radius: 6px;
  }
  .skip-link:focus { top: 0.5rem; }
  :focus-visible { outline: 2px solid var(--accent-strong); outline-offset: 2px; border-radius: 2px; }
  main {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2rem 1rem;
    min-height: 60vh;
  }
  main.wide { max-width: none; padding: 0; }
  main h1, main h2, main h3 { color: var(--accent); line-height: 1.3; }
  main :is(h2, h3, h4)[id] { scroll-margin-top: 1.5rem; }
  main h2 { padding-bottom: 0.3rem; border-bottom: 2px solid var(--highlight); }
  main img { max-width: 100%; height: auto; border-radius: 6px; }
  main pre { overflow-x: auto; padding: 1rem; border-radius: 6px; background: #1e1e1e; }
  main code { font-size: 0.9em; }
  main pre code { background: none; }

  /* Markdown tables are wrapped in .table-wrap (see astro.config.mjs) so
     wide ones scroll sideways instead of pushing the page wider on phones. */
  .table-wrap { overflow-x: auto; margin: 1.25rem 0; }
  main table { border-collapse: collapse; width: 100%; font-size: 0.92em; line-height: 1.6; }
  main th, main td { border: 1px solid var(--border); padding: 0.45rem 0.7rem; text-align: left; vertical-align: top; }
  main th { background: var(--surface); color: var(--accent); white-space: nowrap; }
  main tbody tr:nth-child(even) td { background: color-mix(in srgb, var(--surface) 60%, transparent); }
  main blockquote { margin: 1rem 0; padding: 0.25rem 1rem; border-left: 3px solid var(--highlight); color: var(--muted); }

  /*
   * Post page: on wide screens the TOC sits sticky to the left of the
   * article, the pair centred within the header's page width. Below 1100px
   * the TOC collapses into a <details> above the content.
   */
  .post-layout { max-width: var(--max-width); margin: 0 auto; padding: 2rem 1rem; }
  .toc-sidebar { display: none; }
  .toc-title { margin: 0 0 0.5rem; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--muted); }
  .toc ol { list-style: none; margin: 0; padding: 0; }
  .toc a { display: block; color: var(--muted); line-height: 1.4; }
  .toc a:hover { color: var(--accent); text-decoration: none; }
  .toc-inline {
    margin: 0 0 1.75rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
  }
  .toc-inline summary { cursor: pointer; padding: 0.6rem 1rem; font-weight: 600; color: var(--accent); }
  .toc-inline .toc { padding: 0 1rem 0.75rem; max-height: 60vh; overflow-y: auto; }
  .toc-inline .toc a { padding: 0.35rem 0; }
  .toc-inline .toc ol ol { padding-left: 1rem; font-size: 0.92em; }
  @media (min-width: 1100px) {
    .post-layout.has-toc {
      max-width: var(--page-width);
      display: grid;
      grid-template-columns: var(--toc-width) minmax(0, var(--max-width));
      justify-content: center;
      column-gap: 2.5rem;
    }
    .has-toc .toc-sidebar {
      display: block;
      position: sticky;
      top: 1.5rem;
      align-self: start;
      max-height: calc(100vh - 3rem);
      overflow-y: auto;
      padding: 0.25rem 0.5rem 1rem 0;
      font-size: 0.875rem;
      scrollbar-width: thin;
    }
    .has-toc .toc-inline { display: none; }
    .toc-sidebar .toc a { padding: 0.3rem 0 0.3rem 0.75rem; border-left: 2px solid var(--border); }
    .toc-sidebar .toc ol ol { display: none; }
    .toc-sidebar .toc li.open > ol { display: block; }
    .toc-sidebar .toc ol ol a { padding-left: 1.5rem; font-size: 0.95em; }
    .toc-sidebar .toc a.active { color: var(--accent); border-left-color: var(--accent-strong); font-weight: 600; }
  }

  .back-to-top {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--accent);
    font-size: 1.2rem;
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.12);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s;
  }
  .back-to-top.visible { opacity: 1; pointer-events: auto; }
  .back-to-top:hover { text-decoration: none; color: var(--accent-strong); }
  html { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .back-to-top { transition: none; }
  }
  .site-footer .travellings-badge { display: inline-block; line-height: 0; }
  .site-footer .travellings-badge img { display: block; height: auto; }
  .site-footer {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 2rem 1rem;
    color: var(--muted);
    font-size: 0.9em;
    border-top: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .site-footer p { margin: 0; }
  .post-meta {
    color: var(--muted);
    font-size: 0.9em;
    margin-bottom: 1.5rem;
  }
  .heading-count { font-size: 0.55em; font-weight: 500; color: var(--muted); vertical-align: middle; }
  .breadcrumb { margin: 0 0 0.25rem; font-size: 0.9em; color: var(--muted); }

  .post-list { list-style: none; padding: 0; margin: 0; }
  .post-list-item { position: relative; padding: 1.1rem 0; border-bottom: 1px solid var(--border); }
  /* The title link covers the whole item, so clicking anywhere opens the
     post; category and tag links sit above it and stay clickable. */
  .post-list-item h2 a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .post-list-item h2 a:focus-visible { outline: none; }
  .post-list-item:has(h2 a:focus-visible) { outline: 2px solid var(--accent-strong); outline-offset: 2px; }
  .post-list-item:hover h2 a { color: var(--accent-strong); }
  .post-list-item .post-meta a, .post-list-item .tag { position: relative; z-index: 1; }
  .post-list-item h2 {
    margin: 0 0 0.2rem;
    padding-bottom: 0;
    border-bottom: none;
    font-size: 1.3rem;
  }
  .post-list-item .post-meta { margin: 0 0 0.4rem; }
  .post-list-item .post-meta a { color: var(--muted); }
  .post-list-item .post-meta a:hover { color: var(--accent); }
  .post-excerpt {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.65;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .tag-list { display: flex; gap: 0.4rem; flex-wrap: wrap; margin: 0.6rem 0 0; }
  .tag {
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--accent);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.05rem 0.6rem;
  }
  a.tag:hover { border-color: var(--accent-strong); text-decoration: none; }
  .tag .count { color: var(--muted); }

  /* Home: post list plus a sidebar for browsing by category, tag and year. */
  .home-layout { max-width: var(--page-width); margin: 0 auto; padding: 2rem 1rem; }
  .home-main > h1 { margin-top: 0; }
  .home-sidebar { margin-top: 2.5rem; display: grid; gap: 1.75rem; }
  .sidebar-section h2 {
    margin: 0 0 0.6rem;
    padding-bottom: 0.3rem;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
    border-bottom: 1px solid var(--border);
  }
  .sidebar-section .tag-list { margin: 0; }
  .sidebar-more { margin: 0.6rem 0 0; font-size: 0.9rem; }
  .count-list { list-style: none; margin: 0; padding: 0; }
  .count-list li { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding: 0.2rem 0; }
  .count-list .count, .tag .count { font-size: 0.85em; color: var(--muted); font-variant-numeric: tabular-nums; }
  .count-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr)); column-gap: 2rem; }
  .count-grid li { border-bottom: 1px dashed var(--border); }
  /* Listing pages (tags index, a tag's posts) that use the full page width. */
  .page-wide { max-width: var(--page-width); margin: 0 auto; padding: 2rem 1rem; }

  /* From tablet width up, post lists become a grid of cards: as many
     ~24rem columns as fit, so wide screens show more posts per screen. */
  @media (min-width: 768px) {
    .post-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr)); gap: 1rem; margin-top: 1rem; }
    .post-list-item {
      display: flex;
      flex-direction: column;
      padding: 1rem 1.15rem;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: var(--surface);
      transition: border-color 0.15s;
    }
    .post-list-item:hover { border-color: var(--accent-strong); }
    .post-list-item .post-excerpt { -webkit-line-clamp: 3; }
    .post-list-item .tag-list { margin-top: auto; padding-top: 0.75rem; }
    .post-list-item .tag { background: var(--bg); }
  }
  @media (min-width: 960px) {
    .home-layout { display: grid; grid-template-columns: minmax(0, 1fr) 17rem; column-gap: 3.5rem; }
    .home-sidebar { margin-top: 0; align-content: start; position: sticky; top: 1.5rem; max-height: calc(100vh - 3rem); overflow-y: auto; scrollbar-width: thin; padding-right: 0.25rem; }
  }

  /* Archive: one compact row per post, grouped by year; on wide screens the
     years move into the same sticky sidebar the post TOC uses. */
  .archive-years { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; margin-bottom: 1rem; }
  .toc-sidebar .toc .count { float: right; font-size: 0.85em; color: var(--muted); }
  @media (min-width: 1100px) { .has-toc .archive-years { display: none; } }
  .archive-year h2 { scroll-margin-top: 1rem; }
  .archive-list { list-style: none; margin: 0; padding: 0; }
  .archive-list li { display: flex; align-items: baseline; gap: 1rem; padding: 0.3rem 0; border-bottom: 1px dashed var(--border); }
  .archive-list time { flex: none; color: var(--muted); font-variant-numeric: tabular-nums; }

  /*
   * Shared styling for the hand-drawn inline SVG diagrams that replace
   * dead-image placeholders left over from the Halo migration. Diagrams
   * are plain inline <svg data-diagram> markup in post content; these
   * rules keep them on the site's theme (incl. dark mode) without every
   * diagram having to repeat fill/stroke colors.
   */
  svg[data-diagram] {
    display: block;
    width: 100%;
    height: auto;
    max-width: 640px;
    margin: 1.75rem auto;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', 'Noto Sans SC', sans-serif;
  }
  svg[data-diagram] .d-box {
    fill: var(--surface);
    stroke: var(--accent);
    stroke-width: 1.5;
  }
  svg[data-diagram] .d-box-muted {
    fill: var(--bg);
    stroke: var(--border);
    stroke-width: 1.5;
  }
  svg[data-diagram] .d-box-alt {
    fill: var(--bg);
    stroke: var(--muted);
    stroke-width: 1.5;
    stroke-dasharray: 4 3;
  }
  svg[data-diagram] .d-line {
    stroke: var(--fg);
    stroke-width: 1.5;
    fill: none;
  }
  svg[data-diagram] .d-line-muted {
    stroke: var(--muted);
    stroke-width: 1.25;
    fill: none;
  }
  svg[data-diagram] .d-line-accent {
    stroke: var(--accent-strong);
    stroke-width: 1.75;
    fill: none;
  }
  svg[data-diagram] .d-arrow {
    fill: var(--fg);
  }
  svg[data-diagram] .d-arrow-muted {
    fill: var(--muted);
  }
  svg[data-diagram] .d-arrow-accent {
    fill: var(--accent-strong);
  }
  svg[data-diagram] text {
    fill: var(--fg);
    font-size: 13px;
  }
  svg[data-diagram] .d-label {
    fill: var(--muted);
    font-size: 11px;
  }
  svg[data-diagram] .d-title {
    fill: var(--accent);
    font-weight: 600;
    font-size: 13px;
  }
  svg[data-diagram] .d-mono {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
</style>
